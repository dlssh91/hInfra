  "rules": {
    "DBM-001": {
    },
    "DBM-002": {
    },
    "DBM-003": {
      "Note": {
        "***": "계정이 잠겨있거나, 사용 기간이 만료된 계정을 취약으로 판단"
      },
      "ACCOUNT_LOCKED": ["Y"],
      "PASSWORD_EXPIRED": ["Y"]
    },
    "DBM-004": {
      "Note": {
        "***": "권한을 확인하여 기본 관리자 계정외 권한이 할당되는 경우 취약으로 판단"
      },
      "PRIVILEGE_TYPE": ["CREATE","DROP", "RELOAD", "SHUTDOWN", "PROCESS", "FILE", "REFERENCES", "ALTER", "SUPER", "EXECUTE","APPLICATION_PASSWORD_ADMIN","AUTHENTICATION_POLICY_ADMIN"]
    },
    "DBM-005": {
      "Note": {
        "***": "스크립트 분석에서 PASS, PWD, PSWD 등이 포함된 스크립트 결과 활용"
      }
    },
    "DBM-006": {
      "Note": {
        "***": "failed_login_attempts 값이 설정이 안되어 있거나 특정 숫자 이하면 취약으로 판단"
      },
      "USER_ATTRIBUTES": ["5"]
    },
    "DBM-007": {
      "Note": {
        "***": "패스워드 검증 플러그인이 없거나, validate_password_policy 정책이 LOW, MEDIUM이면 취약"
      },
      "VARIABLE_VALUE": ["LOW", "MEDIUM"]
    },
    "DBM-008": {
      "Note": {
        "***": "PASSWORD_LAST_CHANGED 시간을 확인하여 90일 초과시 취약"
      },
      "DAY": ["90"]
    },
    "DBM-009": {
      "Note": {
        "***": "wait_timeout 시간을 확인하여 900초 초과시 취약"
      },
      "VARIABLE_NAME": ["wait_timeout"],
      "TIME": ["900"]
    },
    "DBM-010": {
    },
    "DBM-011": {
      "Note": {
        "***": "audit_log.so 플러그인을 호출하지 못하거나 audit_log_file이 설정이 NULL이면 취약"
      },
      "VARIABLE_VALUE": ["NULL"]
    },
    "DBM-012": {
    },
    "DBM-013": {
      "Note": {
        "***": "mysql.user 테이블에서 계정별 Host 칼럼이 %인 경우 취약"
      },
      "HOST": ["%"]
    },
